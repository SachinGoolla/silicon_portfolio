[options]
# fpu_round is purely combinational: BMC depth=1 is exhaustive (no induction needed).
# mode prove runs k-induction which OOMs z3 on 428-signal bitvector formula.
mode bmc
depth 1

[engines]
smtbmc --stbv z3

[script]
read -formal fpu_round.sv
prep -top fpu_round

[files]
../rtl/fpu_round.sv
