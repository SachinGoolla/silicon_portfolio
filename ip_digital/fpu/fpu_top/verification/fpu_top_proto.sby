[options]
# fpu_top protocol invariant: ready_o = ~busy_o (combinational tautology —
# rtl/fpu_top.sv: `assign busy_o = div_busy; assign ready_o = ~busy_o;`).
# True for ANY value of div_busy — both sides reduce to `~div_busy` after
# substitution. It's a pure fact about fpu_top.sv's own wire assignments;
# no submodule needs to be real to prove it, including fpu_divsqrt (which
# drives div_busy) — see fpu_top_proto_formal_stub.sv for the full story
# of how this was narrowed down (state-size reduction got z3 past its old
# crash point; the final blocker was fpu_divsqrt's own division/sqrt
# bit-vector arithmetic exhausting 8GB on a single BMC step, unrelated to
# FF count — division/sqrt logic is a known-hard case for SMT
# bit-blasting). Every fpu_top submodule is a free (anyseq) stand-in here;
# only fpu_top.sv itself is real — confirmed BMC depth 10 passes in <1s at
# this size, so full k-induction (the strictly stronger unbounded proof,
# genuinely warranted now that it costs nothing) is back on.
mode prove
depth 10

[engines]
smtbmc z3

[script]
read -formal fpu_top_proto_formal_stub.sv
read -formal fpu_top.sv
prep -top fpu_top

[files]
fpu_top_proto_formal_stub.sv
../rtl/fpu_top.sv
