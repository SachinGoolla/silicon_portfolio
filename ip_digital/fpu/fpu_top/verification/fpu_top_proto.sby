[options]
# fpu_top protocol invariants: ready_o = ~busy_o (combinational tautology)
# smtbmc z3 (no --stbv): uses SMT arrays instead of bitvectors; handles 767 FFs.
# smtbmc --stbv z3 OOMs on this design; abc pdr has a sby v0.64 Python bug.
mode bmc
depth 10

[engines]
smtbmc z3

[script]
read -formal fpu_round.sv
read -formal fpu_flags.sv
read -formal fpu_clk_gate_ctrl.sv
read -formal fpu_noncomp.sv
read -formal fpu_fma.sv
read -formal fpu_cvt.sv
read -formal fpu_divsqrt.sv
read -formal fpu_result_mux.sv
read -formal fpu_operand_iso.sv
read -formal fpu_top.sv
prep -top fpu_top

[files]
../rtl/fpu_round.sv
../rtl/fpu_flags.sv
../rtl/fpu_clk_gate_ctrl.sv
../rtl/fpu_noncomp.sv
../rtl/fpu_fma.sv
../rtl/fpu_cvt.sv
../rtl/fpu_divsqrt.sv
../rtl/fpu_result_mux.sv
../rtl/fpu_operand_iso.sv
../rtl/fpu_top.sv
