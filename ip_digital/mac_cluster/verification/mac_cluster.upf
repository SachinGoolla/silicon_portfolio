# UPF 2.1 — Power intent for mac_cluster (single power domain).
# Composes 4x mac_tile_axi + 4x tile_ni + mesh_2x2 behind one AXI4-Lite
# decoder -- entirely single-clock, always-on, no domain crossings, no
# power switches (same shape as mac_tile_axi.upf, one level up).

create_power_domain PD_TOP -include_scope

create_supply_net  VDD -domain PD_TOP
create_supply_net  VSS -domain PD_TOP

connect_supply_net VDD -ports { VDD }
connect_supply_net VSS -ports { VSS }

create_supply_set  SS_TOP \
    -function {power VDD} \
    -function {ground VSS}

associate_supply_set SS_TOP -handle PD_TOP.primary
