[options]
mode bmc
depth 10

[engines]
smtbmc boolector

[script]
read_verilog -sv -D FORMAL mesh_router.sv xy_route.sv axis_skid.sv rr_arbiter.sv
chparam -set PAYLOAD_W 8 -set FLIT_W 14 mesh_router
prep -top mesh_router

[files]
../rtl/mesh_router.sv
../rtl/xy_route.sv
../rtl/axis_skid.sv
../rtl/rr_arbiter.sv
